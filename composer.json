{
    "name": "lcsilva/lcookies",
    "description": "Development tools of LCookies (static analysis and coding standard). Not part of the extension package.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G"
    }
}
