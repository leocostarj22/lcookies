{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lcsilva:lcookies:contract:1",
  "title": "LCookies frontend contract",
  "description": "Generated by Lcsilva\\Component\\Lcookies\\Administrator\\Contract\\ContractBuilder and published by plg_system_lcookies with addScriptOptions('lcookies', ...). Read in JavaScript with Joomla.getOptions('lcookies'). Layouts, site JavaScript, the backend preview and the API use only this contract. Increase `schema` on incompatible changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policyVersion", "expiryDays", "cookie", "endpoint", "layout", "theme", "floatingButton", "privacyUrl", "respectGpc", "autoblock", "iframePlaceholder", "gcm", "categories", "texts"],
  "properties": {
    "schema": { "const": 1, "description": "Version of this format." },
    "policyVersion": { "type": "integer", "minimum": 1, "description": "Consent stored with another version is ignored and the banner is shown again." },
    "expiryDays": { "type": "integer", "minimum": 1, "maximum": 395, "description": "Validity of the consent cookie." },
    "cookie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domain"],
      "properties": {
        "name": { "const": "lcookies_consent" },
        "domain": { "type": "string", "description": "Cookie domain, empty for the current host." }
      }
    },
    "endpoint": { "type": ["string", "null"], "description": "URL that records the consent: POST, Content-Type application/json, body {consent: {id, v, cats, ts}, action, url}. null when logging is off." },
    "layout": { "enum": ["bar-bottom", "bar-top", "box-bottom-left", "box-bottom-right", "modal"] },
    "theme": { "enum": ["auto", "light", "dark"] },
    "floatingButton": { "enum": ["left", "right", null], "description": "Position of the button that reopens the preferences, null if disabled." },
    "privacyUrl": { "type": ["string", "null"] },
    "respectGpc": { "type": "boolean", "description": "With navigator.globalPrivacyControl, categories with gpcOptOut stay rejected." },
    "autoblock": { "type": "boolean", "description": "Block scripts and iframes that match the services' patterns." },
    "iframePlaceholder": { "type": "boolean" },
    "gcm": {
      "description": "Google Consent Mode v2, null if disabled.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["waitForUpdate", "adsDataRedaction", "urlPassthrough"],
          "properties": {
            "waitForUpdate": { "type": "integer", "minimum": 0 },
            "adsDataRedaction": { "type": "boolean" },
            "urlPassthrough": { "type": "boolean" }
          }
        }
      ]
    },
    "categories": {
      "type": "array",
      "description": "Published categories in order. Optional categories without published services are left out.",
      "items": { "$ref": "#/$defs/category" }
    },
    "texts": {
      "type": "object",
      "description": "Interface texts, translated. `message` may contain HTML; `placeholder` and `placeholderAllow` contain the tokens {service} and {category}.",
      "additionalProperties": { "type": "string" },
      "required": ["label", "title", "message", "acceptAll", "rejectAll", "settings", "save", "close", "preferencesTitle", "preferencesIntro", "alwaysActive", "privacyPolicy", "details", "provider", "noCookies", "colName", "colType", "colDuration", "colDescription", "typeCookie", "typeLocal", "typeSession", "typePixel", "placeholder", "placeholderAllow", "floating", "gpc"]
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "title", "description", "required", "gcm", "gpcOptOut", "services"],
      "properties": {
        "alias": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean", "description": "Always active, no switch." },
        "gcm": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["ad_storage", "ad_user_data", "ad_personalization", "analytics_storage", "functionality_storage", "personalization_storage", "security_storage"] }
        },
        "gpcOptOut": { "type": "boolean", "description": "Rejected when Global Privacy Control is on (marketing or advertising consent types)." },
        "services": { "type": "array", "items": { "$ref": "#/$defs/service" } }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alias", "title", "provider", "description", "privacyUrl", "patterns", "cookies"],
      "properties": {
        "id": { "type": "integer" },
        "alias": { "type": "string" },
        "title": { "type": "string" },
        "provider": { "type": "string" },
        "description": { "type": "string" },
        "privacyUrl": { "type": ["string", "null"] },
        "patterns": {
          "type": "array",
          "description": "Blocking patterns: plain text is a case-insensitive substring of the script/iframe address or inline code; /.../ is a regular expression.",
          "items": { "type": "string" }
        },
        "cookies": { "type": "array", "items": { "$ref": "#/$defs/cookie" } }
      }
    },
    "cookie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "match", "type", "domain", "duration", "description"],
      "properties": {
        "name": { "type": "string" },
        "match": { "enum": ["exact", "prefix", "regex"] },
        "type": { "enum": ["cookie", "local", "session", "pixel"] },
        "domain": { "type": "string" },
        "duration": { "type": "string", "description": "Translated, e.g. \"2 years\"." },
        "description": { "type": "string" }
      }
    }
  }
}
