<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>mod_lcookies</name>
	<author>leocostadeveloper</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 leocostadeveloper</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail></authorEmail>
	<authorUrl>https://www.leocostadeveloper.com</authorUrl>
	<version>0.5.0</version>
	<description>MOD_LCOOKIES_XML_DESCRIPTION</description>
	<namespace path="src">Lcsilva\Module\Lcookies</namespace>
	<files>
		<folder module="mod_lcookies">services</folder>
		<folder>language</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<media destination="mod_lcookies" folder="media">
		<filename>joomla.asset.json</filename>
		<folder>js</folder>
	</media>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="show_status"
					type="radio"
					label="MOD_LCOOKIES_FIELD_SHOW_STATUS_LABEL"
					description="MOD_LCOOKIES_FIELD_SHOW_STATUS_DESC"
					layout="joomla.form.field.radio.switcher"
					default="1"
					filter="integer"
					>
					<option value="0">JHIDE</option>
					<option value="1">JSHOW</option>
				</field>
				<field
					name="show_policy"
					type="radio"
					label="MOD_LCOOKIES_FIELD_SHOW_POLICY_LABEL"
					description="MOD_LCOOKIES_FIELD_SHOW_POLICY_DESC"
					layout="joomla.form.field.radio.switcher"
					default="1"
					filter="integer"
					>
					<option value="0">JHIDE</option>
					<option value="1">JSHOW</option>
				</field>
				<field
					name="button_text"
					type="text"
					label="MOD_LCOOKIES_FIELD_BUTTON_TEXT_LABEL"
					description="MOD_LCOOKIES_FIELD_BUTTON_TEXT_DESC"
					filter="string"
					maxlength="100"
				/>
				<field
					name="button_style"
					type="list"
					label="MOD_LCOOKIES_FIELD_BUTTON_STYLE_LABEL"
					default="button"
					validate="options"
					>
					<option value="button">MOD_LCOOKIES_FIELD_BUTTON_STYLE_BUTTON</option>
					<option value="link">MOD_LCOOKIES_FIELD_BUTTON_STYLE_LINK</option>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
					class="form-select"
					validate="moduleLayout"
				/>
				<field
					name="moduleclass_sfx"
					type="textarea"
					label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					rows="3"
					validate="CssIdentifier"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
