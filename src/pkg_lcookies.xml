<?xml version="1.0" encoding="UTF-8"?>
<extension type="package" method="upgrade">
	<name>pkg_lcookies</name>
	<packagename>lcookies</packagename>
	<author>Lcsilva</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 Lcsilva</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail></authorEmail>
	<authorUrl>https://github.com/leocostarj22/lcookies</authorUrl>
	<version>0.4.0</version>
	<description>PKG_LCOOKIES_XML_DESCRIPTION</description>
	<packager>Lcsilva</packager>
	<blockChildUninstall>true</blockChildUninstall>
	<scriptfile>script.php</scriptfile>

	<files folder="packages">
		<file type="component" id="com_lcookies">com_lcookies.zip</file>
		<file type="plugin" id="lcookies" group="system">plg_system_lcookies.zip</file>
		<file type="plugin" id="lcookies" group="webservices">plg_webservices_lcookies.zip</file>
	</files>

	<languages folder="language">
		<language tag="en-GB">en-GB/pkg_lcookies.sys.ini</language>
		<language tag="pt-PT">pt-PT/pkg_lcookies.sys.ini</language>
	</languages>

	<!-- Asset of every GitHub release (always the latest one), generated by build/build.py and attached by .github/workflows/release.yml. -->
	<updateservers>
		<server type="extension" priority="1" name="LCookies">https://github.com/leocostarj22/lcookies/releases/latest/download/pkg_lcookies.xml</server>
	</updateservers>
</extension>
